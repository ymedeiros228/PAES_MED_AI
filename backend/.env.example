# ── Tutor IA / LLM ──────────────────────────────────────────────
# Sem chave: o app ENSINA em modo offline-tutor-v2 (edital + banco + socrático).
# Com chave: diálogo com modelo + RAG da base local.

# OpenAI cloud (ou proxy)
OPENAI_API_KEY=cole_sua_chave_aqui
OPENAI_MODEL=gpt-4.1-mini

# Opcional — API OpenAI-compatible (Groq, OpenRouter, Together, Azure, LM Studio, vLLM…)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local (sem chave cloud). Use um dos jeitos:
#   OLLAMA_MODEL=llama3.2
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
# (OLLAMA_HOST ainda funciona como alias de OLLAMA_BASE_URL)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=ollama

# ── Mídia (opcional) ────────────────────────────────────────────
# YouTube Data API v3 — sem chave: catálogo local + busca aberta
YOUTUBE_API_KEY=

# Serper — enriquece leituras; sem chave: Wikipédia + catálogo
SERPER_API_KEY=
